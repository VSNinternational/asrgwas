Type: Package
Package: ASRgwas
Title: ASRgwas an R package to perform Genome-Wide Association Studies
    (GWAS)
Version: 1.1.1
Authors@R: c(
    person("Salvador", "Gezan", , "salvador.gezan@vsni.co.uk", role = c("aut", "cre")),
    person("Giovanni", "Galli", , "giovanni.galli@vsni.co.uk", role = "aut"),
    person("Didier", "Murillo", , "didier.murilloflorez@ndus.edu", role = "aut"),
    person("Darren", "Murray", , "darren.murray@vsni.co.uk", role = "aut"),
    person("VSN International", role = "cph")
